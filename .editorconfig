# xLumen 编辑器统一配置（M01 代码骨架）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{xml,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
