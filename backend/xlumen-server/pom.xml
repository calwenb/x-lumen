<?xml version="1.0" encoding="UTF-8"?>
<!--
  xLumen 父 POM：聚合 7 个模块并统一管理依赖版本（BACKEND.md §4，决策 D15）。
  技术基线版本见 GLOBAL.md §5；框架或核心依赖升级必须单独验证。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.calwen.xlumen</groupId>
    <artifactId>xlumen</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>xlumen</name>
    <description>xLumen：面向个人博主的 AI 内容创作与知识对话平台（模块化单体，决策 D1）</description>

    <modules>
        <module>xlumen-common</module>
        <module>xlumen-identity</module>
        <module>xlumen-content</module>
        <module>xlumen-publishing</module>
        <module>xlumen-knowledge</module>
        <module>xlumen-ai</module>
        <module>xlumen-boot</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <hutool.version>5.8.38</hutool.version>
        <springdoc.version>3.1.0</springdoc.version>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.calwen.xlumen</groupId>
                <artifactId>xlumen-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.calwen.xlumen</groupId>
                <artifactId>xlumen-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.calwen.xlumen</groupId>
                <artifactId>xlumen-content</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.calwen.xlumen</groupId>
                <artifactId>xlumen-publishing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.calwen.xlumen</groupId>
                <artifactId>xlumen-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.calwen.xlumen</groupId>
                <artifactId>xlumen-ai</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus：Boot 4 专用 starter + 分页与优化器支持（BACKEND.md §2） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Hutool：通用工具首选（BACKEND.md §6.1） -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-json</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- springdoc-openapi：OpenAPI 契约唯一来源（决策 D4），3.x 适配 Boot 4 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- 保留参数名元数据：@PathVariable/@RequestParam 隐式名称绑定依赖 -parameters（BACKEND.md §5.1） -->
                        <parameters>true</parameters>
                        <!-- JDK 23+ 必须显式声明 Lombok 注解处理器，否则注解不生效（BACKEND.md §2） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
