<?xml version="1.0" encoding="UTF-8"?>
<!-- xlumen-ai：AI 引擎 + 对话 + 增值（ai_ + chat_ + ai_enhance_）。
     依赖 knowledge（检索与引用溯源）；AI 完成后发布业务事件，不反向依赖 content（BACKEND.md §14，决策 D3）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.calwen.xlumen</groupId>
        <artifactId>xlumen</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xlumen-ai</artifactId>
    <name>xlumen-ai</name>
    <description>AI 引擎 + 对话 + 增值（ai_ + chat_ + ai_enhance_）</description>

    <dependencies>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-knowledge</artifactId>
        </dependency>

        <!-- Web / 校验（SSE 与模块内 Controller） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus（ai_task/ai_scene_config/chat_ 表） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 任务进度短期状态存 Redis（决策 D6） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 全量迁移后的 AI 模型客户端（OPT-2/D20）：ChatModel/ChatClient/ToolCallback，版本随父 BOM
             （自动配置由装配层 spring.ai.model.*: none 关闭，双供应商手动装配） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <exclusions>
                <!-- openai-java-core 传递的非 jakarta 注解与 springdoc 同包冲突（/v3/api-docs 500），对应 jakarta 版由父 BOM 钉 2.2.52 -->
                <exclusion>
                    <groupId>io.swagger.core.v3</groupId>
                    <artifactId>swagger-annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <!-- JSON 解析（结构化输出 Schema 校验，F-0604） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-json</artifactId>
        </dependency>

        <!-- OpenAPI 注解（决策 D4 契约唯一来源）：boot 装配模块已引 springdoc，此处仅编译期用 @Schema -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.52</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
