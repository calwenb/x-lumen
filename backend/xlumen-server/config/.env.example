# xLumen 配置模板（决策 D8：.env 是配置唯一载体；复制为 .env 并填写真实值，.env 不入库）
# Windows 下必须以 UTF-8 无 BOM 编码保存，否则 Spring Boot 解析占位符失败。
# 本文件为标准 properties 语法：KEY=VALUE，# 开头为注释。

# ---- MySQL（业务事实，BACKEND.md §7 单实例单 Schema） ----
XLUMEN_DB_URL=jdbc:mysql://127.0.0.1:3306/xlumen_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
XLUMEN_DB_HOST=127.0.0.1
XLUMEN_DB_PORT=3306
XLUMEN_DB_NAME=xlumen_dev
XLUMEN_DB_USERNAME=root
XLUMEN_DB_PASSWORD=your-password

# ---- Redis（仅短期状态，决策 D6） ----
XLUMEN_REDIS_HOST=127.0.0.1
XLUMEN_REDIS_PORT=6379
XLUMEN_REDIS_PASSWORD=your-password

# ---- JWT（M02 身份模块启用） ----
XLUMEN_JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---- AI 供应商密钥（M06 AI 引擎启用；密钥唯一来源，决策 D8） ----
XLUMEN_BAILIAN_API_KEY=
XLUMEN_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XLUMEN_BAILIAN_MODEL_WRITING=qwen-plus
XLUMEN_BAILIAN_MODEL_REVIEWER=qwen-plus
XLUMEN_BAILIAN_MODEL_QA=qwen-plus
XLUMEN_BAILIAN_MODEL_SUMMARY=qwen-plus
XLUMEN_BAILIAN_MODEL_EMBEDDING=text-embedding-v4
XLUMEN_DEEPSEEK_API_KEY=
XLUMEN_DEEPSEEK_BASE_URL=https://api.deepseek.com
XLUMEN_DEEPSEEK_MODEL_WRITING=deepseek-chat
XLUMEN_DEEPSEEK_MODEL_REVIEWER=deepseek-chat
XLUMEN_DEEPSEEK_MODEL_QA=deepseek-chat
XLUMEN_DEEPSEEK_MODEL_SUMMARY=deepseek-chat
XLUMEN_DEEPSEEK_MODEL_EMBEDDING=

# ---- Milvus 向量库（M05 RAG 启用；本机 Docker：milvusdb/milvus standalone，端口 19530） ----
XLUMEN_MILVUS_HOST=127.0.0.1
XLUMEN_MILVUS_PORT=19530
XLUMEN_MILVUS_DATABASE=default

# ---- 日志级别（BACKEND.md §15.2，经 .env 控制不写死） ----
XLUMEN_LOG_LEVEL=INFO

# ---- 开发启动端口守卫（IDEA-008；生产必须关闭） ----
XLUMEN_SERVER_PORT=8080
XLUMEN_DEV_PORT_GUARD=false
