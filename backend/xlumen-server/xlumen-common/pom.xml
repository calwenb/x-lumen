<?xml version="1.0" encoding="UTF-8"?>
<!-- xlumen-common 基座：ApiResponse/BizException/WorkspaceContext/RequestId 等真正通用的基础类型。
     不放业务 Entity、业务 DTO、Mapper 或万能工具类（BACKEND.md §4）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.calwen.xlumen</groupId>
        <artifactId>xlumen</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xlumen-common</artifactId>
    <name>xlumen-common</name>
    <description>基座模块：统一响应、业务异常、工作空间上下文与请求 ID</description>

    <dependencies>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>
        <!-- Servlet API 由 Web 容器提供，基座仅编译期依赖（RequestId 过滤器） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- RequestIdFilter 依赖 OncePerRequestFilter（spring-web + spring-context），版本由 Boot BOM 管理 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
