<?xml version="1.0" encoding="UTF-8"?>
<!-- xlumen-publishing：审核发布与公开读（pub_）+ 互动反馈（eng_）。
     依赖 content（文章与版本是内容侧事实源）与 ai（审校能力）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.calwen.xlumen</groupId>
        <artifactId>xlumen</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xlumen-publishing</artifactId>
    <name>xlumen-publishing</name>
    <description>审核发布与公开读 + 互动反馈（pub_ + eng_）</description>

    <dependencies>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-content</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-ai</artifactId>
        </dependency>

        <!-- Web / 校验（模块内 Controller 依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus（eng_ 评论/点赞 Mapper） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 阅读量防刷短期状态存 Redis（决策 D6） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
