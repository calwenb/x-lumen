<?xml version="1.0" encoding="UTF-8"?>
<!-- xlumen-content：内容管理（cnt_）+ 数据分析与知识保鲜（analytics_，V2/V3）。
     通过 AiApi 创建 AI 任务（BACKEND.md §14）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.calwen.xlumen</groupId>
        <artifactId>xlumen</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xlumen-content</artifactId>
    <name>xlumen-content</name>
    <description>内容管理 + 数据分析与知识保鲜（cnt_ + analytics_）</description>

    <dependencies>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-identity</artifactId>
        </dependency>
        <!-- knowledge：知识库/目录归属校验（内容侧经 KnowledgeApi 校验 kbId/directoryId，BACKEND.md §4 依赖 DAG） -->
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-ai</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Boot 4 专用 starter + 分页优化器（BACKEND.md §2） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
