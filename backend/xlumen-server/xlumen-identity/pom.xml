<?xml version="1.0" encoding="UTF-8"?>
<!-- xlumen-identity：身份与多租户（iam_）+ 平台治理（plt_）。
     工作空间与权限是全局横切能力，被所有业务模块依赖（BACKEND.md §4）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.calwen.xlumen</groupId>
        <artifactId>xlumen</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xlumen-identity</artifactId>
    <name>xlumen-identity</name>
    <description>身份与多租户 + 平台治理（iam_ + plt_）</description>

    <dependencies>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-common</artifactId>
        </dependency>

        <!-- Web / 校验（模块内 Controller 依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Boot 4 专用 starter + 分页优化器（BACKEND.md §2） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- JWT 编解码（oauth2-jose）与 BCrypt（security-crypto），Bean 由 boot 装配 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 刷新令牌短期状态存 Redis（决策 D6，BACKEND.md §15.3 GETDEL 轮换） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
