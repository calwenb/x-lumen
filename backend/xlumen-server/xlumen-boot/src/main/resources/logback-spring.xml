<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置（BACKEND.md §15.2）：Appender 显式激活，避免"有配置无日志"；
  日志携带 requestId（MDC）保证链路可定位；级别经 .env 的 XLUMEN_LOG_LEVEL 控制。
  不记录令牌、密码、密钥与完整敏感 Prompt（安全约定见 BACKEND.md §15.3）。
-->
<configuration>
    <!-- 从 Spring Environment 读取日志级别，缺省 INFO -->
    <springProperty scope="context" name="LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <!-- 控制台 Appender：本地开发默认激活 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId:-}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件 Appender：按天滚动，保留 30 天 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/xlumen.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/xlumen.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId:-}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 显式激活两个 Appender（仅声明不激活会导致有配置无日志） -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
