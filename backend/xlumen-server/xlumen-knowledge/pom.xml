<?xml version="1.0" encoding="UTF-8"?>
<!-- xlumen-knowledge：文章知识索引 RAG（kb_），发布即索引（决策 D13），被 ai 依赖。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.calwen.xlumen</groupId>
        <artifactId>xlumen</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xlumen-knowledge</artifactId>
    <name>xlumen-knowledge</name>
    <description>文章知识索引 RAG：发布即索引（kb_）</description>

    <dependencies>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.calwen.xlumen</groupId>
            <artifactId>xlumen-identity</artifactId>
        </dependency>

        <!-- Web MVC / 参数校验（IndexController 检索测试） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Boot 4 专用 starter + 分页/优化器支持 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- Redis：数据依赖（短期状态缓存） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Hutool：通用工具首选 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <!-- Lombok：DTO/VO 简化 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
