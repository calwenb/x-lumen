# ---- IDE ----
/.idea

# ---- 本地覆盖配置（.env 载体已废除，仅作本地临时覆盖忽略） ----
.env
*.env.local

# ---- 环境 profile（D30：dev/test/prod 含真实密钥不入库，仅 application-demo.yml 模板入库） ----
frontend/**/.env.production
backend/xlumen-server/xlumen-boot/src/main/resources/application-dev.yml
backend/xlumen-server/xlumen-boot/src/main/resources/application-test.yml
backend/xlumen-server/xlumen-boot/src/main/resources/application-prod.yml

# ---- 后端 ----
backend/**/target/
*.class
*.jar
!**/lib/**

# ---- 前端 ----
node_modules/
frontend/**/dist/
frontend/**/playwright-report/
frontend/**/test-results/
frontend/**/coverage/

# ---- 验证产物 ----
.browser-check/
.corepack/

# ---- 编辑器与系统 ----
.idea/workspace.xml
.vscode/
*.log
.DS_Store
Thumbs.db

# ---- ZCode 会话内部数据 ----
.zcode/

# ---- 本地测试与运行残留（logs 含 token，禁止入库） ----
logs/
.browser-check.zip

