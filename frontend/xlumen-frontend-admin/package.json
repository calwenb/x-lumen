{
  "name": "xlumen-frontend-admin",
  "version": "0.1.0",
  "private": true,
  "description": "xLumen 管理后台（仅管理员）：空间/成员/角色、模型配置、审计日志等配置管理（FRONTEND.md §2，:5174）",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
